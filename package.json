{
  "name": "diagc-monorepo",
  "private": true,
  "version": "1.1.3",
  "type": "module",
  "bin": {
    "diagc": "bin/diagc.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "sh -c 'pnpm compile:watch & trap \"trap - TERM EXIT; kill 0\" EXIT INT TERM; pnpm studio'",
    "typecheck": "tsc -p packages/core/tsconfig.json && tsc -p packages/diagc/tsconfig.json && tsc -p packages/icons/tsconfig.json && tsc -p packages/renderer/tsconfig.json && tsc -p apps/studio/tsconfig.json && tsc -p apps/viewer/tsconfig.json && tsc -p apps/obsidian/tsconfig.json",
    "studio": "pnpm --filter @diagc/studio dev",
    "compile": "tsx packages/diagc/src/cli.ts compile",
    "compile:watch": "tsx packages/diagc/src/cli.ts watch",
    "publish-diagrams": "tsx packages/diagc/src/cli.ts publish",
    "publish-site": "gh-pages -d .diagrams/html",
    "build:site": "node scripts/build-site.mjs",
    "build:cli": "pnpm --filter @diagc/viewer build",
    "build:studio": "pnpm --filter @diagc/studio build",
    "build:obsidian": "pnpm --filter @diagc/obsidian build",
    "build:core": "tsc -p packages/core/tsconfig.build.json && node scripts/fix-esm-extensions.mjs packages/core/dist",
    "build:diagc": "tsc -p packages/diagc/tsconfig.build.json && node scripts/fix-esm-extensions.mjs packages/diagc/dist",
    "build:dist": "pnpm build:core && pnpm build:diagc && pnpm build:cli && pnpm build:studio && node scripts/stage-assets.mjs",
    "lint": "npx eslint .",
    "lint:prune": "npx eslint . --prune-suppressions",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,js,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,js,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "marked": "^18.0.6",
    "prettier": "^3.9.9",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.18.1",
  "dependencies": {
    "@diagc/core": "workspace:*"
  }
}
