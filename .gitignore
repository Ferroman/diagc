node_modules/
.diagrams/.artifacts/
dist/
.diagrams/src/scratch/

# Browser artifacts staged into the CLI package by `pnpm build:dist`; rebuilt
# on every pack, never committed.
packages/diagc/assets/
# Same deal: a build-time copy of the root THIRD-PARTY-NOTICES.md, which `files`
# needs package-relative. Edit the root copy, never this one.
packages/diagc/THIRD-PARTY-NOTICES.md
.claude/*
CLAUDE.md
AGENTS.md

# Generated interactive diagram pages (published to a gh-pages branch, not main).
# .diagrams/static/ (README PNGs) is intentionally NOT ignored — it is committed.
# Except the pictures of the working notes in .diagrams/src/thinking/: those sources stay
# off the site (pages.yml removes them), and their pictures are nobody's to commit.
.diagrams/static/thinking/
.diagrams/html/
.diagrams/diff/
# The assembled GitHub Pages site (`pnpm build:site`); pages.yml builds its own.
_site/

.worktrees/
